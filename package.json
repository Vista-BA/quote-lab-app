{
  "name": "quote-lab-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "7-Eleven Quote Desk (v4) and Quote Lab on Postgres + pgvector (Neon), deployable to Vercel",
  "scripts": {
    "build": "node desk/build.mjs && node scripts/build.mjs",
    "load": "node scripts/load.mjs",
