  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^1.72.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "esbuild": "^0.28.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
