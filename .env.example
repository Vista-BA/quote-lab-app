# Neon connection string (Neon console > Connect > pooled). Set this in Vercel, not in git.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# Optional: turns on Claude for reading the call and writing the scope. Prices stay in code.
ANTHROPIC_API_KEY=
QUOTE_MODEL=claude-haiku-4-5
# Optional: if set, saving drafts / adding or removing quotes needs this key (the page asks once).
LAB_WRITE_KEY=
